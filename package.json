{
  "name": "clownkosh",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run copy-worker && vite",
    "build": "npm run copy-worker && vite build",
    "copy-worker": "node -e \"const fs = require('fs'); if (!fs.existsSync('./public')) fs.mkdirSync('./public'); fs.copyFileSync('./node_modules/pdfjs-dist/build/pdf.worker.min.mjs', './public/pdf.worker.min.mjs');\"",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "dexie": "^4.4.4",
    "framer-motion": "^13.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.28.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
